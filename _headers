# Cloudflare Pages reads this file; GitHub Pages (which serves elimenti.com) ignores it,
# because Jekyll skips files that start with an underscore.

# Keep the pages.dev copy of the site out of search results. elimenti.com is canonical.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Working files that Cloudflare Pages publishes (Jekyll excludes them on GitHub Pages).
/seo/*
  X-Robots-Tag: noindex
/PLAN.md
  X-Robots-Tag: noindex
/SEO-AUDIT.md
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Fonts never change under the same name. Images and CSS/JS can, so they get shorter caching.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=2592000
